# Modèle de secret — COPIE en .env puis mets ta vraie clé.
#   cp .env.example .env
# Le vrai .env n'est JAMAIS versionné (voir .gitignore).

# Clé Gemini — gratuite, sans carte bancaire : https://aistudio.google.com/apikey
GEMINI_API_KEY=remplace_par_ta_cle

# Facultatif : modèle par défaut (se règle aussi depuis la page Réglages).
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_MODEL_AUDIT=gemini-flash-lite-latest

# Facultatif : récupération automatique des articles de code manquants.
# Sans ces deux clés, le système SIGNALE les textes absents au lieu de les
# télécharger — il n'invente jamais un article.
# Compte gratuit sur https://piste.gouv.fr, puis abonnement à l'API « Légifrance ».
# LEGIFRANCE_CLIENT_ID=
# LEGIFRANCE_CLIENT_SECRET=
